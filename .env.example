# ====================== Telegram Bot ======================
# Токен бота — получить у @BotFather
TELEGRAM_BOT_TOKEN=

# Чат, куда отправлять ВСЕ новые модели (chat_id или @username группы)
TELEGRAM_NEW_MODELS_CHAT_ID=

# Чат, куда отправлять только бесплатные модели (можно тот же чат)
TELEGRAM_FREE_MODELS_CHAT_ID=

# ====================== OpenRouter API ======================
# API-ключ (необязателен, но с ним лимиты щедрее)
# Взять: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ====================== Настройки ======================
# Расписание проверки (cron-формат)
CRON_SCHEDULE=*/30 * * * *

# Папка для кэша известных моделей
CACHE_DIR=cache

# Максимум сообщений за один прогон на группу
MAX_MESSAGES_PER_GROUP=15
